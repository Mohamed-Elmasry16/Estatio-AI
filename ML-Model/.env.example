# Copy to .env and fill in. Never commit the real .env.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
# Use the SERVICE ROLE key here (server-side only). Never expose this to the frontend.
SUPABASE_SERVICE_KEY=your-service-role-key
# Table/view holding the raw listings snapshot (same 14 columns as egypt_listings_raw.csv).
SUPABASE_LISTINGS_TABLE=egypt_listings_raw
SUPABASE_PAGE_SIZE=1000

# --- Model / retrain ---
MODELS_DIR=./models
MIN_TRAINING_ROWS=1000

# --- API ---
# If set, POST /predict and /admin/reload require header: X-API-Key: <value>
PREDICTOR_API_KEY=
# Comma-separated list of allowed frontend origins, e.g. https://app.example.com,https://example.com
CORS_ALLOW_ORIGINS=*
