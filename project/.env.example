# ---------------------------------------------------------------------------
# Postgres
#
# Get these from your hosting dashboard -> Project Settings -> Database ->
# Connection string. NEVER commit the real .env file — it's already in
# .gitignore. Rotate the password if it's ever pasted into a chat, ticket,
# or committed by accident (Project Settings -> Database -> Reset password).
#
# DATABASE_URL          — Transaction pooler, port 6543. Used for all normal
#                          pipeline reads/writes. Good for short-lived,
#                          high-churn connections (exactly what a batch
#                          pipeline does), but does NOT support DDL or
#                          session-level features reliably.
#
# DATABASE_MIGRATION_URL — Session pooler or direct connection, port 5432.
#                          Used only for `alembic upgrade` and the one-time
#                          `CREATE EXTENSION vector`. If you leave this
#                          blank, src/db.py derives it automatically from
#                          DATABASE_URL by swapping :6543 for :5432.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@[YOUR-DB-HOST]:6543/postgres
DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@[YOUR-DB-HOST]:5432/postgres

# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# text (readable, local dev) | json (structured, for log aggregators in prod)
LOG_FORMAT=text

# --- Connection pool / resilience tuning (sane defaults, override if needed) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_SECONDS=10
DB_SSLMODE=require
DB_RETRY_ATTEMPTS=3
DB_RETRY_MIN_WAIT_SECONDS=1
DB_RETRY_MAX_WAIT_SECONDS=8

# --- Scraper (source-specific settings — fill in your own credentials) ---
# All values below are required for the scraper stage. Never hardcode them
# in source code; they come from this file only.
SCRAPER_APP_ID=
SCRAPER_API_KEY=
SCRAPER_INDEX_NAME=
# Endpoint template for the search index API. The {app_id} placeholder is
# replaced at runtime with SCRAPER_APP_ID.
SCRAPER_BASE_URL_TEMPLATE=
# Template used to build each listing's public URL from its external id.
# The {external_id} placeholder is replaced at runtime, e.g.
#   LISTING_URL_TEMPLATE=https://www.example-portal.com/property/details-{external_id}.html
# Leave blank to disable URL building (url columns stay NULL).
LISTING_URL_TEMPLATE=

# Only needed for build_vectors.py — leave blank until you're ready for the chatbot
NVIDIA_API_KEY=
